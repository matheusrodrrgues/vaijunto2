FROM golang:1.27-alpine AS compilacao
WORKDIR /projeto
COPY go.mod ./
COPY comum ./comum
COPY terminal ./terminal
COPY motorista ./motorista
RUN CGO_ENABLED=0 go build -o /vaijunto-motorista ./motorista

FROM alpine:3.22
COPY --from=compilacao /vaijunto-motorista /vaijunto-motorista
ENTRYPOINT ["/vaijunto-motorista"]
